APP_NAME=System Monitor
APP_ENV=production
API_DOCS_ENABLED=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_DB_URL=postgresql+psycopg2://postgres.your-project-ref:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=
SUPABASE_AUTH_TIMEOUT_SECONDS=8
INGEST_API_TOKEN=change-me
REQUIRE_ADMIN_AUTH=true
ADMIN_USERNAME=monitoradmin
ADMIN_PASSWORD=change-this-now
ALLOWED_HOSTS=monitor.example.com,localhost,127.0.0.1
HEARTBEAT_TIMEOUT_SECONDS=120
ALERT_CPU_THRESHOLD=90
ALERT_MEMORY_THRESHOLD=90
ALERT_DISK_THRESHOLD=90
ALERT_COOLDOWN_SECONDS=300
ALERT_WEBHOOK_URL=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=monitor@yourdomain.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=8
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CORS_ALLOW_ORIGINS=https://monitor.example.com
