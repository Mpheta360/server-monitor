MONITOR_API_URL=http://127.0.0.1:8000/api/v1/ingest
MONITOR_API_TOKEN=change-me
MONITOR_ENVIRONMENT=production
MONITOR_REGION=us-east-1
MONITOR_AGENT_KEY=web-01-prod
MONITOR_DISPLAY_NAME=web-01-prod
MONITOR_TAGS=web,linux
MONITOR_INTERVAL_SECONDS=15
MONITOR_TIMEOUT_SECONDS=20
MONITOR_SERVICES=nginx,postgresql
MONITOR_NGINX_ENABLED=true
MONITOR_NGINX_STATUS_URL=http://127.0.0.1:8080/nginx_status
MONITOR_NGINX_VERIFY_TLS=true
MONITOR_NGINX_APPS=public-site|https://example.com/health,admin-api|https://example.com/admin/health
MONITOR_HEALTHCHECK_URL=http://127.0.0.1:8000/health
MONITOR_HEALTHCHECK_VERIFY_TLS=true
